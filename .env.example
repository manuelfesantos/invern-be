# Copy to .dev.vars and fill in. These are the runtime string vars the code
# reads; bindings (D1/KV/R2/rate-limiters) live in wrangler config, not here.

# Environment
ENV="local"                 # local | preview | prod
LOGGER_LEVEL="30"           # pino level: 20 debug, 30 info, 40 warn, 50 error
DOMAIN=""                   # cookie domain, e.g. example.com

# Hosts / origins
FRONTEND_HOST=""            # storefront origin (post-checkout redirects + CORS allow-list)
BACKOFFICE_HOST=""          # backoffice/admin origin (CORS allow-list), e.g. http://localhost:5173
IMAGES_HOST=""              # base URL uploaded image URLs advertise. Prod: the R2 public domain (https://images.invernspirit.com). Local: the worker's own serving route, http://localhost:8790/public/images
STOCK_HOST=""               # base URL of the R2 stock bucket (cache purge target)

# Crypto (see libs/utils/crypto)
TOKEN_SECRET=""             # base64 HS512 secret for access tokens
REFRESH_TOKEN_SECRET=""     # base64 HS512 secret for refresh tokens
ENCRYPTION_KEY=""           # AES-GCM key, exactly 16/24/32 chars
DEFAULT_IV=""               # legacy AES-GCM IV fallback, 12+ chars
SALT=""                     # password/salt material, 16 chars

# Stripe (test-mode keys locally)
STRIPE_API_KEY=""           # sk_test_... / sk_live_...
STRIPE_ENV="local"          # tag events belong to; must match event metadata.stripeEnv
STRIPE_CHECKOUT_SECRET=""   # whsec_... for /stripe/session-result
STRIPE_PAYMENT_SECRET=""    # whsec_... for /stripe/payment-intent

# Brevo (transactional email)
BREVO_API_KEY=""            # xkeysib-...
BREVO_DOMAIN=""             # sending domain
BREVO_NAME=""               # sender display name

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""      # path appended to FRONTEND_HOST

# Cloudflare cache purge (libs/adapters/r2/utils/cache)
CACHE_API_KEY=""
CACHE_API_EMAIL=""
ZONE_ID=""

# Self-gated setup secret for POST /private/stock/setup
SETUP_STOCK_SECRET=""
