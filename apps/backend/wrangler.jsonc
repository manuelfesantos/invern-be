{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "invern-backend",
  "main": "src/server.ts",
  "compatibility_date": "2025-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // ── TOP LEVEL = LOCAL DEV ONLY ──────────────────────────────────────────────
  // `wrangler dev` / `npm start` use this (with .dev.vars for secrets). Deploys
  // MUST target a named env (`--env preview` / `--env production`); named envs do
  // NOT inherit bindings/vars/routes/triggers/ratelimits, so each repeats them
  // with its own real values. `main`/`compatibility_*`/`observability` DO inherit.
  //
  // Scheduled maintenance sweep — daily 03:00 UTC (src/scheduled.ts).
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "INVERN_DB",
      "database_name": "invern-db",
      "database_id": "ddf70d9c-9ea3-4279-abe6-614941edfddc",
      "migrations_dir": "../../drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "STOCK_BUCKET", "bucket_name": "stock-local" },
    { "binding": "IMAGES_BUCKET", "bucket_name": "images-local" }
  ],
  // Local KV ids are placeholder strings (miniflare treats them as names).
  "kv_namespaces": [
    { "binding": "AUTH_KV", "id": "auth_kv" },
    { "binding": "VALIDATION_KV", "id": "validation_kv" },
    { "binding": "STOCK_KV", "id": "stock_kv" }
  ],
  // Rate limiting on credential endpoints (per-email). period must be 10 or 60.
  // namespace_id is an account-unique integer — no resource to provision.
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "EMAIL_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],

  "env": {
    // ── PREVIEW (staging) — deployed from the `preview` branch ────────────────
    "preview": {
      "name": "invern-backend-preview",
      "workers_dev": false,
      "preview_urls": false,
      // TODO(operator): point at the real preview API hostname + DNS/zone.
      "routes": [{ "pattern": "api-preview.invernspirit.com", "custom_domain": true }],
      // Non-secret runtime config. Secrets (STRIPE_*, TOKEN_SECRET, ENCRYPTION_KEY,
      // REFRESH_TOKEN_SECRET, SALT, SETUP_STOCK_SECRET, GOOGLE_CLIENT_*, BREVO_API_KEY)
      // are set via `wrangler secret put <NAME> --env preview` — never here.
      "vars": {
        "ENV": "preview",
        "STRIPE_ENV": "test",
        "DOMAIN": "invernspirit.com",
        "FRONTEND_HOST": "https://preview.invernspirit.com",
        "IMAGES_HOST": "https://images-preview.invernspirit.com",
        "STOCK_HOST": "https://stock-preview.invernspirit.com",
        "GOOGLE_REDIRECT_URI": "https://api-preview.invernspirit.com/auth/google/callback",
        "BREVO_DOMAIN": "invernspirit.com",
        "BREVO_NAME": "Invern Spirit"
      },
      "d1_databases": [
        {
          "binding": "INVERN_DB",
          "database_name": "invern-db-preview",
          "database_id": "REPLACE_WITH_PREVIEW_D1_ID",
          "migrations_dir": "../../drizzle"
        }
      ],
      "r2_buckets": [
        { "binding": "STOCK_BUCKET", "bucket_name": "invern-stock-preview" },
        { "binding": "IMAGES_BUCKET", "bucket_name": "invern-images-preview" }
      ],
      "kv_namespaces": [
        { "binding": "AUTH_KV", "id": "REPLACE_WITH_PREVIEW_AUTH_KV_ID" },
        { "binding": "VALIDATION_KV", "id": "REPLACE_WITH_PREVIEW_VALIDATION_KV_ID" },
        { "binding": "STOCK_KV", "id": "REPLACE_WITH_PREVIEW_STOCK_KV_ID" }
      ],
      "triggers": { "crons": ["0 3 * * *"] },
      "ratelimits": [
        { "name": "LOGIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
        { "name": "EMAIL_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
      ]
    },

    // ── PRODUCTION — deployed from the `main` branch ──────────────────────────
    "production": {
      "name": "invern-backend-production",
      "workers_dev": false,
      "preview_urls": false,
      // TODO(operator): the real API hostname + DNS/zone.
      "routes": [{ "pattern": "api.invernspirit.com", "custom_domain": true }],
      "vars": {
        "ENV": "production",
        // TODO(operator): flip to "live" (and set live Stripe keys) at go-live.
        "STRIPE_ENV": "test",
        "DOMAIN": "invernspirit.com",
        "FRONTEND_HOST": "https://invernspirit.com",
        "IMAGES_HOST": "https://images.invernspirit.com",
        "STOCK_HOST": "https://stock.invernspirit.com",
        "GOOGLE_REDIRECT_URI": "https://api.invernspirit.com/auth/google/callback",
        "BREVO_DOMAIN": "invernspirit.com",
        "BREVO_NAME": "Invern Spirit"
      },
      "d1_databases": [
        {
          "binding": "INVERN_DB",
          "database_name": "invern-db-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "../../drizzle"
        }
      ],
      "r2_buckets": [
        { "binding": "STOCK_BUCKET", "bucket_name": "invern-stock-production" },
        { "binding": "IMAGES_BUCKET", "bucket_name": "invern-images-production" }
      ],
      "kv_namespaces": [
        { "binding": "AUTH_KV", "id": "REPLACE_WITH_PRODUCTION_AUTH_KV_ID" },
        { "binding": "VALIDATION_KV", "id": "REPLACE_WITH_PRODUCTION_VALIDATION_KV_ID" },
        { "binding": "STOCK_KV", "id": "REPLACE_WITH_PRODUCTION_STOCK_KV_ID" }
      ],
      "triggers": { "crons": ["0 3 * * *"] },
      // Distinct namespace_ids from preview so rate-limit counters don't collide.
      "ratelimits": [
        { "name": "LOGIN_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 8, "period": 60 } },
        { "name": "EMAIL_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } }
      ]
    }
  }
}
