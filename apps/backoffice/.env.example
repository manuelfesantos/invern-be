# Backend API base URL (build-time, baked into the bundle — not a secret).
# Dev + tunnel: leave UNSET — the app calls the same-origin `/api` and Vite
# proxies it to the backend (see vite.config.ts). Prod: set the absolute URL,
# e.g. https://api.invernspirit.com
# VITE_API_BASE_URL="https://api.invernspirit.com"

# Country context used to reach the country-scoped auth routes (admin login).
VITE_LOGIN_COUNTRY="PT"
