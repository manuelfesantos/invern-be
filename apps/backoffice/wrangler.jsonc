{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "invern-backoffice",
  "compatibility_date": "2025-09-20",
  // Static-assets-only Worker (no server script): serves the built SPA and
  // falls back to index.html for client-side routes.
  //
  // Top level = local `wrangler dev`/preview. Deploys target a named env
  // (`--env preview` / `--env production`); `assets` and `routes` do NOT inherit,
  // so each env repeats them. VITE_API_BASE_URL is baked at BUILD time (CI), not
  // here — this worker only serves the pre-built dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "preview": {
      "name": "invern-backoffice-preview",
      "workers_dev": false,
      "preview_urls": false,
      // TODO(operator): the real backoffice hostname + DNS/zone.
      "routes": [{ "pattern": "admin-preview.invernspirit.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    },
    "production": {
      "name": "invern-backoffice-production",
      "workers_dev": false,
      "preview_urls": false,
      // TODO(operator): the real backoffice hostname + DNS/zone.
      "routes": [{ "pattern": "admin.invernspirit.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
