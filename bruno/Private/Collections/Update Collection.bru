meta {
  name: Update Collection
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/private/collections/{{collectionId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Updated Collection",
    "description": "Updated description."
  }
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.
}
