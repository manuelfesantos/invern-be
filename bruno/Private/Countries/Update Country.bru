meta {
  name: Update Country
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/private/countries/{{countryCode}}
  body: json
  auth: none
}

body:json {
  {
    "code": "PT",
    "name": "Portugal",
    "locale": "pt-PT",
    "currencyCode": "EUR"
  }
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.
}
