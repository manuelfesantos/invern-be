meta {
  name: Summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/private/dashboard
  body: none
  auth: none
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.

  Returns { counts: { orders, products, users, collections }, lowStock: [{id,name,stock}],
  recentOrders: [{id,createdAt,isCanceled}] }. Computed in one D1 batch.
}
