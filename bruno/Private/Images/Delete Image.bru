meta {
  name: Delete Image
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/private/images/{{imageKey}}
  body: none
  auth: none
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.

  Deletes the image record AND its underlying R2 object (identified by its R2 key, the
  `<uuid>.<ext>` filename stored in `imageKey` by Upload Image). Unknown key -> 404.
}
