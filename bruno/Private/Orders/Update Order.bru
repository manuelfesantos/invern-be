meta {
  name: Update Order
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/private/orders/{{orderId}}
  body: json
  auth: none
}

body:json {
  {
    "address": {
      "street": "Rua de Teste",
      "houseNumber": "1",
      "postalCode": "1000-001",
      "city": "Lisboa",
      "country": "PT"
    },
    "personalDetails": {
      "email": "customer@example.com",
      "firstName": "Ana",
      "lastName": "Silva"
    }
  }
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.

  Constrained update: only `address` and `personalDetails` are accepted. Financial/
  immutable fields (stripeId, paymentId, products, isCanceled, ...) are ignored —
  cancel via /cancel, fulfillment via /fulfillment.
}
