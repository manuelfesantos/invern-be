meta {
  name: Create Product
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/private/products
  body: json
  auth: none
}

body:json {
  {
    "name": "New Product",
    "description": "A description",
    "priceInCents": 1500,
    "collectionId": "{{collectionId}}",
    "stock": 10,
    "weight": 400
  }
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.
}
