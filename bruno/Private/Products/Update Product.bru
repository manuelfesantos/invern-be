meta {
  name: Update Product
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/private/products/{{productId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Updated Product",
    "description": "Updated",
    "priceInCents": 1800,
    "collectionId": "{{collectionId}}",
    "stock": 10,
    "weight": 400
  }
}

vars:pre-request {
  collectionId: 123
  productId: 
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.
}
