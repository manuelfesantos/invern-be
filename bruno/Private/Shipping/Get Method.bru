meta {
  name: Get Method
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/private/shipping/methods/{{shippingMethodId}}
  body: none
  auth: none
}

vars:pre-request {
  shippingMethodId: c809ba43-09a7-48bd-a35c-3026c0d00841
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.
  
  Returns the method with all of its rates (unfiltered by weight). Unknown id -> 404.
}
