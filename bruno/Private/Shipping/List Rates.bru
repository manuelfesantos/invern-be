meta {
  name: List Rates
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/private/shipping/methods/{{shippingMethodId}}/rates
  body: none
  auth: none
}

vars:pre-request {
  shippingMethodId: c809ba43-09a7-48bd-a35c-3026c0d00841
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403.
  
  All rates for the method as a plain list (bounded by weight bands; not paginated).
  Each rate includes its countryCodes.
}
