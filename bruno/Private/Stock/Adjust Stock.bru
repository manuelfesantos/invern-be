meta {
  name: Adjust Stock
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/private/stock/{{productId}}
  body: json
  auth: none
}

body:json {
  {
    "delta": 5
  }
}

vars:pre-request {
  productId: 2fef20d6-4fa9-461a-8acb-ba87c3e15c5e
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403. Adjusts the product's stock by a signed delta (+N adds, -N removes) across D1 + KV + R2 (write-through) — never an absolute set, so it composes with checkout reservations. Removing more than available returns an error.
}
