meta {
  name: Set Stock
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/private/stock/{{productId}}
  body: json
  auth: none
}

body:json {
  {
    "stock": 25
  }
}

vars:pre-request {
  productId: 2fef20d6-4fa9-461a-8acb-ba87c3e15c5e
}

docs {
  Requires an ADMIN session (run Public/Auth/Login (Admin) first). Anonymous -> 401, USER -> 403. Sets the product's absolute stock across D1 + KV + R2 (write-through). Non-negative integer only.
}
