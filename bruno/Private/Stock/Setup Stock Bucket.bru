meta {
  name: Setup Stock Bucket
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/private/stock/setup
  body: json
  auth: none
}

body:json {
  {
    "secretKey": "{{setupStockSecret}}"
  }
}

docs {
  Self-gated by SETUP_STOCK_SECRET (not admin RBAC). Rebuilds the stock bucket from D1.
  Set `setupStockSecret` in your Bruno environment to the SETUP_STOCK_SECRET from
  `.dev.vars` — never hardcode the secret in this file (it is committed to git).
}
