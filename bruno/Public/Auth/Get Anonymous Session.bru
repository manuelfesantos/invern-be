meta {
  name: Get Anonymous Session
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/public/countries/{{countryCode}}/config
  body: none
  auth: none
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
  let sc = res.headers["set-cookie"];
  if (sc) {
    if (!Array.isArray(sc)) sc = [sc];
    for (const c of sc) {
      const m = /(?:^|;\s*)s_r=([^;]+)/.exec(c);
      if (m) { bru.setEnvVar("refreshToken", m[1]); break; }
    }
  }
}

docs {
  Run first. Stores anonymous accessToken + refreshToken.
}
