meta {
  name: Signup
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/public/countries/{{countryCode}}/user/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "someone@example.com",
    "password": "a-strong-password",
    "firstName": "Ana",
    "lastName": "Silva",
    "remember": true
  }
}

script:post-response {
  // Local dev returns the verification code in the body (no email is sent);
  // store it so **Verify Email** can use it automatically.
  if (res.body && res.body.data && res.body.data.verificationCode) {
    bru.setEnvVar("verificationCode", res.body.data.verificationCode);
  }
}

docs {
  Creates an **unvalidated** USER. This does NOT log you in — the response
  carries no token/cookie. Next step: **Verify Email**.

  New signups are always role USER + unvalidated, so `login` will reject them
  until verified. To create an admin instead, use `npm run create-admin`.

  Requires the anonymous session first (run **Get Anonymous Session**).

  - **Local**: no email is sent — the response includes `verificationCode`,
    which this request stores into the `verificationCode` env var for
    **Verify Email**.
  - **Other envs**: an 8-digit code is emailed via Brevo instead.
}
