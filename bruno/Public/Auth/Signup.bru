meta {
  name: Signup
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/public/countries/{{countryCode}}/user/signup
  body: json
  auth: none
}

body:json {
  {
    "email": "someone@example.com",
    "password": "a-strong-password",
    "firstName": "Ana",
    "lastName": "Silva"
  }
}

docs {
  Creates an unvalidated USER and sends a verification email (Brevo).
}
