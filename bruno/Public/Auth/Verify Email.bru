meta {
  name: Verify Email
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/public/countries/{{countryCode}}/user/signup/verify-email
  body: json
  auth: none
}

body:json {
  {
    "email": "someone@example.com",
    "code": "{{verificationCode}}"
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
  let sc = res.headers["set-cookie"];
  if (sc) {
    if (!Array.isArray(sc)) sc = [sc];
    for (const c of sc) {
      const m = /(?:^|;\s*)s_r=([^;]+)/.exec(c);
      if (m) { bru.setEnvVar("refreshToken", m[1]); break; }
    }
  }
}

docs {
  Completes signup: validates the code, marks the account validated, and LOGS
  YOU IN — this response carries the accessToken + s_r cookie (stored here),
  unlike Signup itself.

  Requires the anonymous session first (run **Get Anonymous Session**). Use the
  same `email` you signed up with. Locally the `code` is auto-filled from the
  `verificationCode` env var that **Signup** stored; in other envs, paste the
  code from the email.
}
