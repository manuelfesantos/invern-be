# Stable public hostname (a subdomain of your Cloudflare domain).
DEV_HOSTNAME=dev.invernspirit.com

# Google OAuth client (Cloud Console → APIs & Services → Credentials → OAuth
# client ID → Web application). Authorized redirect URI must be:
#   https://dev.invernspirit.com/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# 32-byte cookie secret. Generate with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → create → Docker →
# copy the token). Configure the public hostname there to point at the service
# http://oauth2-proxy:4180.
CLOUDFLARE_TUNNEL_TOKEN=
