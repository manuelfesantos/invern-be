{
  "name": "invern-be",
  "type": "module",
  "version": "1.0.0",
  "description": "Invern Spirit Backend",
  "main": "apps/backend/src/server.ts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run local --workspace=backend",
    "test": "jest --coverage",
    "lint": "eslint libs apps/*/src",
    "lint:fix": "eslint libs apps/*/src --fix",
    "build-remote-db": "wrangler d1 create invern-db-preview --location weur",
    "build-preview-db": "wrangler d1 create invern-db-preview --location weur",
    "query-local": "wrangler d1 execute invern-db --local --command",
    "query-preview": "wrangler d1 execute invern-db --remote --command",
    "db:migrate:local": "wrangler d1 migrations apply invern-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply invern-db --remote",
    "seed": "node scripts/seed.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "type-check": "tsc --noEmit",
    "build": "turbo run build",
    "dev": "turbo run local",
    "dev:backend": "turbo run local --filter=backend",
    "type-check:apps": "turbo run type-check",
    "openapi:check": "node scripts/openapi/check-openapi.mjs",
    "docs": "http-server ./ -p 8081 -S -c-1 -C ./docs/cert.pem -K docs/key.pem --cors"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@cloudflare/workers-types": "^4.20240419.0",
    "@eslint/js": "^9.2.0",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^30.0.0",
    "@types/stripe-v3": "^3.1.33",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.23.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.4.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.11",
    "jest": "^30.1.3",
    "js-yaml": "^5.2.1",
    "prettier": "^3.2.5",
    "swagger-ui-dist": "^5.20.5",
    "ts-jest": "^29.1.2",
    "turbo": "^2.10.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.29.0",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@tsndr/cloudflare-worker-jwt": "^3.2.0",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "query-string": "^9.3.0",
    "stripe": "^18.5.0",
    "zod": "^4.1.8"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "qs": "^6.15.3"
  }
}
