{
  "name": "invern-be",
  "type": "module",
  "version": "1.0.0",
  "description": "Invern Spirit Backend",
  "main": "functions/index.ts",
  "scripts": {
    "init": "node ./scripts/init.js",
    "start": "node ./scripts/start.js",
    "test": "jest --coverage --passWithNoTests",
    "lint": "npx eslint functions/** libs/**",
    "build-remote-db": "npx drizzle-kit migrate && node drizzle/triggers/run-triggers.js",
    "build-preview-db": "npx drizzle-kit migrate & node drizzle/triggers/run-triggers.js",
    "query-local": "node ./scripts/query-local.js",
    "query-preview": "node ./scripts/query-remote.js preview",
    "prepare": "husky",
    "db:generate": "npx drizzle-kit generate",
    "type-check": "npx tsc --noEmit",
    "docs": "http-server ./ -p 8081 -S -c-1 -C ./docs/cert.pem -K docs/key.pem --cors"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@cloudflare/workers-types": "^4.20240419.0",
    "@eslint/js": "^9.2.0",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^29.5.12",
    "@types/stripe-v3": "^3.1.33",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.23.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.1.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "swagger-ui-dist": "^5.20.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.29.0"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-honeycomb": "^1.0.4",
    "@libsql/client": "^0.15.0",
    "@tsndr/cloudflare-worker-jwt": "^2.5.3",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.1",
    "drizzle-zod": "^0.5.1",
    "query-string": "^9.1.1",
    "short-uuid": "^5.2.0",
    "stripe": "^15.6.0",
    "worker-auth-providers": "^0.0.14",
    "zod": "3.24.2"
  }
}
