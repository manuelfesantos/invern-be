{
  "name": "invern-be",
  "type": "module",
  "version": "1.0.0",
  "description": "Invern Spirit Backend",
  "main": "functions/index.ts",
  "scripts": {
    "init": "node ./scripts/init.js",
    "start": "node ./scripts/start.js",
    "test": "jest --coverage --passWithNoTests",
    "lint": "npx eslint functions/** libs/**",
    "lint:fix": "npx eslint functions/** libs/** --fix",
    "build-remote-db": "npx wrangler d1 create invern-db-preview --location weur",
    "build-preview-db": "npx wrangler d1 create invern-db-preview --location weur",
    "query-local": "npx wrangler d1 execute invern-db --local --command",
    "query-preview": "npx wrangler d1 execute invern-db --remote --command",
    "db:migrate:local": "npx wrangler d1 migrations apply invern-db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply invern-db --remote",
    "prepare": "husky",
    "db:generate": "npx drizzle-kit generate",
    "type-check": "npx tsc --noEmit",
    "docs": "http-server ./ -p 8081 -S -c-1 -C ./docs/cert.pem -K docs/key.pem --cors"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@cloudflare/workers-types": "^4.20240419.0",
    "@eslint/js": "^9.2.0",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^29.5.12",
    "@types/stripe-v3": "^3.1.33",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.23.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.1.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "swagger-ui-dist": "^5.20.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.29.0",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-honeycomb": "^1.0.4",
    "@libsql/client": "^0.15.15",
    "@tsndr/cloudflare-worker-jwt": "^3.2.0",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "query-string": "^9.3.0",
    "stripe": "^18.5.0",
    "worker-auth-providers": "^0.0.14",
    "zod": "^4.1.8"
  }
}
