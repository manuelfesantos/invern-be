{
  "name": "invern-be",
  "type": "module",
  "version": "1.0.0",
  "description": "Invern Spirit Backend",
  "main": "functions/index.ts",
  "scripts": {
    "init": "npm i && npm run start",
    "start": "concurrently -k -n \"DB,API\" -c \"blue,green\" \"npm run build-local-db\" \"npm run local\"",
    "test": "jest --coverage --passWithNoTests",
    "lint": "npx eslint functions/** libs/**",
    "build-local-db": "turso dev --db-file turso/local.db && npx drizzle-kit migrate",
    "build-remote-db": "npx wrangler d1 execute invern-db --remote --file=drizzle/0000_smooth_jack_power.sql",
    "build-preview-db": "npx wrangler d1 execute invern-db-preview --remote --file=drizzle/0000_smooth_jack_power.sql",
    "query-local": "npx wrangler d1 execute INVERN_DB",
    "query-remote": "npx wrangler d1 execute invern-db --remote",
    "query-preview": "npx wrangler d1 execute invern-db-preview --remote",
    "local": "npx wrangler pages dev functions --d1 INVERN_DB=e5193edd-54a6-4b15-8e67-d0bd12b9afd2 --kv=AUTH_KV --compatibility-date=2024-04-26 --compatibility-flag=nodejs_compat --show-interactive-dev-session=false",
    "prepare": "husky",
    "db:generate": "npx drizzle-kit generate",
    "type-check": "npx tsc --noEmit",
    "local-db": "turso dev --db-file turso/local.db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240419.0",
    "@eslint/js": "^9.2.0",
    "@types/cookie": "^0.6.0",
    "@types/jest": "^29.5.12",
    "@types/stripe-v3": "^3.1.33",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.18.1",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.1.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-honeycomb": "^1.0.4",
    "@libsql/client": "^0.15.0",
    "@tsndr/cloudflare-worker-jwt": "^2.5.3",
    "concurrently": "^9.1.2",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.1",
    "drizzle-zod": "^0.5.1",
    "query-string": "^9.1.1",
    "short-uuid": "^5.2.0",
    "stripe": "^15.6.0",
    "worker-auth-providers": "^0.0.14",
    "zod": "^3.23.4"
  }
}
