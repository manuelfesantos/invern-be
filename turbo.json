{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "concurrency": "9",
  "globalDependencies": ["tsconfig.json", "package.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "local": {
      "cache": false,
      "persistent": true
    }
  }
}
